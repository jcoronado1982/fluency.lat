# Copiar a terraform.tfvars (NO versionado, ver .gitignore de este directorio)
# y rellenar. Los valores reales viven en SECRETS_MAP.md (LOCAL ONLY) o en el
# variable group `Flashcard-Secrets` de Azure DevOps -- nunca copiarlos en un
# archivo que pueda terminar commiteado.
#
# Alternativa recomendada para no dejar secretos ni siquiera en este archivo
# local: exportar TF_VAR_<nombre_variable> en el shell antes de `terraform
# apply` (p.ej. `export TF_VAR_jwt_secret=...`) y dejar este .tfvars solo con
# los valores no sensibles.

# --- Imagen de arranque (ver README.md, "Limitación crítica") ---
proxy_image_self_link = "projects/project-c73b1fb9-17ae-4d1b-8f4/global/images/REEMPLAZAR-nombre-imagen-alpine"
# db_image_self_link  = ""  # vacío = usa la misma que proxy_image_self_link

# --- Acceso ---
# ssh_source_ranges = ["TU.IP.PUBLICA.AQUI/32"]

# --- Secretos (ejemplo -- NO dejar valores reales aquí) ---
# database_url                 = "surreal://..."
# gemini_api_key                = "..."
# gcp_api_key                   = "..."
# google_client_id              = "....apps.googleusercontent.com"
# jwt_secret                    = "..."
# super_admin_email             = "admin@fluency.lat"
# google_credentials_json_b64   = "..."  # base64 del JSON de service account
