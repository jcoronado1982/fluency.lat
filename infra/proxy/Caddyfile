qa.fluency.lat {
    # Exponer SurrealDB de forma segura
    handle /db/* {
        uri strip_prefix /db
        reverse_proxy 10.128.0.5:8080
    }

    handle {
        route {
            import db_protection

            # ASSETS ESTÁTICOS QA
            handle /card_images/* {
                root * /usr/share/caddy/qa_repository
                @try_avif {
                    path_regexp avif ^(.+)\.(jpg|jpeg|png)$
                }
                rewrite @try_avif {re.avif.1}.avif
                import asset_cache_policy
                header +X-Content-Type-Options "nosniff"
                file_server
            }

            handle /card_audio/* {
                root * /usr/share/caddy/qa_repository
                import asset_cache_policy
                file_server
            }

            handle /json/* {
                root * /usr/share/caddy/qa_repository
                header Cache-Control "public, no-cache"
                import compression
                file_server browse
            }

            # API QA
            @backend_routes {
                path /api/*
            }
            handle @backend_routes {
                import compression
                reverse_proxy localhost:8081
            }

            # FRONTEND ESTÁTICO QA
            handle {
                root * /usr/share/caddy/qa_flashcard
                import compression
                import spa_cache_policy
                try_files {path} /index.html
                file_server
            }
        }
    }
}
